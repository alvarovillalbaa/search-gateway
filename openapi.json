    "/v1/providers": {
      "get": {
        "summary": "List providers in the gateway key scope",
        "responses": {
          "200": {
            "description": "Provider catalog",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "providers": {
                      "type": "array",
