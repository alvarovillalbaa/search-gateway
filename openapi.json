  "paths": {
    "/health": {
      "get": {
        "summary": "Public health check",
        "security": [],
        "responses": {
          "200": {
            "description": "Healthy process",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "ok"
                    },
                    "version": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "version"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
